<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>[SocksShoppingStore]Program;[SocksShoppingStore]AspNetCoreGeneratedDocument.*</Exclude>
          <!-- Exclude host wiring and Razor views from unit coverage -->
          <ExcludeByFile>**/Program.cs;**/*.cshtml;**/Views/*</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>

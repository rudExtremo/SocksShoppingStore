[
  {
    "name": "Product defects",
    "matchedStatuses": ["failed"],
    "messageRegex": "(Assertion|Expected|Should|Must|EqualTo|Contain)"
  },
  {
    "name": "Test defects",
    "matchedStatuses": ["broken"],
    "traceRegex": ".*",
    "messageRegex": ".*"
  },
  {
    "name": "Infrastructure issues",
    "matchedStatuses": ["failed","broken"],
    "messageRegex": "(timeout|NoSuchElement|WebDriver|connection refused|429|503|certificate|SSL|rate limit)",
    "excludedStatuses": ["passed","skipped"]
  }
]


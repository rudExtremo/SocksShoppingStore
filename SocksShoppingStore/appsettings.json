{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;testsocksshop-agdng4gkcyeuhpgs.westeurope-01.azurewebsites.net"
  ,
  "FreeTier": {
    "Enabled": true,
    "BlockAllTraffic": false,
    "BlockOnAzure": false,
    "AllowPaths": [ "/healthz", "/_status", "/favicon.ico" ]
  },
  "RateLimiting": {
    "GlobalPerMinute": 40,
    "ApiPerMinute": 20
  },
  "Concurrency": {
    "MaxConcurrentRequests": 10
  },
  "Status": {
    "AllowIPs": [ "127.0.0.1", "::1" ],
    "LatencyWindowSize": 200
  },
  "Legal": {
    "ControllerName": "SocksShoppingStore",
    "ContactEmail": "support@socksshop.local"
  },
  "Repository": {
    "Provider": "InMemory", 
    "Json": {
      "Path": "App_Data/products.json"
    }
  },
  "Stripe": {
    "PublishableKey": "",
    "SecretKey": "",
    "WebhookSecret": "",
    "UseTestModeBanner": true,
    "SuccessReturnPath": "/Checkout/ReturnSuccess",
    "CancelReturnPath": "/Checkout/PaymentFailed"
  }
}

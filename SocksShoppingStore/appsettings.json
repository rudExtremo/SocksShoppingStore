{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
  ,
  "FreeTier": {
    "Enabled": true,
    "BlockAllTraffic": false,
    "BlockOnAzure": false,
    "AllowPaths": [ "/healthz", "/_status", "/favicon.ico" ]
  },
  "RateLimiting": {
    "GlobalPerMinute": 40,
    "ApiPerMinute": 20
  },
  "Concurrency": {
    "MaxConcurrentRequests": 10
  },
  "Status": {
    "AllowIPs": [ "127.0.0.1", "::1" ],
    "LatencyWindowSize": 200
  }
}

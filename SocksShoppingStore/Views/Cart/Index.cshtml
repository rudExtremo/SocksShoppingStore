<!-- Файл: Views/Cart/Index.cshtml -->
@model SocksShoppingStore.Models.ShoppingCart

@{
    ViewData["Title"] = T["Cart_Title"];
}

<div class="d-flex justify-content-between align-items-center"><h1 class="mb-0">@ViewData["Title"]</h1>@if (Model.Items.Any()) { <a asp-controller="Cart" asp-action="Clear" class="btn btn-outline-danger">@T["ClearCart"]</a> }</div>

@if (Model.Items.Any())
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>@T["Item"]</th><th class="text-center">@T["PricePerUnit"]</th><th class="text-center">@T["Quantity"]</th><th class="text-end">@T["Subtotal"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Sock.Name</td>
                    <td class="text-center">@Currency.Eur(item.Sock.Price)</td>
                    <td class="text-center">
                        <div class="d-flex align-items-center justify-content-center gap-2">
                            <a asp-controller="Cart" asp-action="RemoveFromCart" asp-route-id="@item.Sock.Id" class="btn btn-sm btn-outline-secondary" title="@T["Decrease"]">-</a>
                            <form asp-controller="Cart" asp-action="SetQuantity" method="post" class="d-inline-flex align-items-center" style="min-width: 120px;">
                                <input type="hidden" name="id" value="@item.Sock.Id" />
                                <input type="number" name="quantity" min="0" class="form-control form-control-sm text-center" value="@item.Quantity" aria-label="Quantity" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary ms-2" title="@T["Update"]">@T["Update"]</button>
                            </form>
                            <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@item.Sock.Id" class="btn btn-sm btn-outline-secondary" title="@T["Increase"]">+</a>
                        </div>
                    </td>
                    <td class="text-end">@Currency.Eur(item.Sock.Price * item.Quantity)</td>
                    <td class="text-center">
                        <a asp-controller="Cart" asp-action="DeleteItem" asp-route-id="@item.Sock.Id" class="btn btn-outline-danger btn-sm" title="@T["RemoveItem"]">
                            <i class="fa-solid fa-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="text-end"><strong>@T["Total"]:</strong></td>
                <td class="text-end"><strong>@Currency.Eur(Model.GetTotalSum())</strong></td>
                <td></td>
            </tr>
        </tfoot>
    </table>
    <div class="d-flex justify-content-end">
        <a asp-controller="Checkout" asp-action="Index" class="btn btn-success">Proceed to Checkout</a>
    </div>
}
else
{
    <div class="alert alert-info">@T["NoItems"]</div>
}

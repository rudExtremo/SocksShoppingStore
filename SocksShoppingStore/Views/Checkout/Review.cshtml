@model SocksShoppingStore.Models.Order
@{
    ViewData["Title"] = "Review order";
}

<h1>@ViewData["Title"]</h1>

<div class="card mb-3">
  <div class="card-header">Shipping details</div>
  <div class="card-body">
    <p class="mb-1"><strong>Name:</strong> @Model.CustomerName</p>
    <p class="mb-1"><strong>Email:</strong> @Model.Email</p>
    <p class="mb-0"><strong>Address:</strong> @Model.AddressLine1 @Model.AddressLine2<br/>@Model.City, @Model.PostalCode, @Model.Country</p>
  </div>
</div>

<table class="table align-middle">
  <thead>
    <tr><th>Item</th><th class="text-center">Qty</th><th class="text-end">Price</th></tr>
  </thead>
  <tbody>
  @foreach(var it in Model.Items)
  {
    <tr>
      <td>@it.Name</td>
      <td class="text-center">@it.Quantity</td>
      <td class="text-end">@SocksShoppingStore.Helpers.Currency.Eur(it.Subtotal)</td>
    </tr>
  }
  </tbody>
  <tfoot>
    <tr>
      <td colspan="2" class="text-end"><strong>Total</strong></td>
      <td class="text-end"><strong>@SocksShoppingStore.Helpers.Currency.Eur(Model.Total)</strong></td>
    </tr>
  </tfoot>
</table>

<form asp-action="Confirm" method="post">
  @Html.AntiForgeryToken()
  <div class="d-grid d-sm-flex gap-2">
    <a asp-action="Index" class="btn btn-outline-secondary">Edit details</a>
    <button type="submit" class="btn btn-success">Confirm order</button>
  </div>
</form>


@model SocksShoppingStore.Models.Sock
@{
    ViewData["Title"] = Model.Name;
}

<div class="row mt-4 product-details">
    <div class="col-md-6">
        <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded product-details-image" />
    </div>
    <div class="col-md-6">
        <h1>@Model.Name</h1>
        <p class="lead">@Model.Description</p>
        <p><strong>@T["Price"]:</strong> @Currency.Eur(Model.Price)</p>
        <div class="product-detail-actions">
            <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@Model.Id" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)" class="btn btn-primary js-add-to-cart">@T["AddToCart"]</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">@T["BackToCatalog"]</a>
        </div>
    </div>
</div>

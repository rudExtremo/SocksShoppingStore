@model SocksShoppingStore.Models.CatalogViewModel
@{
    ViewData["Title"] = "Socks catalog";
    var q = Model.Query ?? string.Empty;
    string Highlight(string text, string query)
    {
        if (string.IsNullOrWhiteSpace(text) || string.IsNullOrWhiteSpace(query)) return System.Net.WebUtility.HtmlEncode(text ?? "");
        var encoded = System.Net.WebUtility.HtmlEncode(text);
        var regex = new System.Text.RegularExpressions.Regex(System.Text.RegularExpressions.Regex.Escape(query), System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return regex.Replace(encoded, m => $"<mark>{m.Value}</mark>");
    }
}

<div class="text-center">
    <h1 class="display-4">@T["Home_Title"]</h1>
    <p class="lead">@T["Home_Lead"]</p>
    <hr />
    <form method="get" asp-controller="Home" asp-action="Index" class="row g-2 mt-3" role="search" aria-label="Catalog search and filters">
        <div class="col-lg-5">
            <input type="text" name="q" class="form-control" value="@q" placeholder="@T["Search_Placeholder"]" aria-label="Search input" />
        </div>
        <div class="col-lg-2">
            <select class="form-select" name="sort" aria-label="Sort">
                <option value="name_asc" selected="@(Model.Sort=="name_asc")">@T["Sort_Name_Asc"]</option>
                <option value="name_desc" selected="@(Model.Sort=="name_desc")">@T["Sort_Name_Desc"]</option>
                <option value="price_asc" selected="@(Model.Sort=="price_asc")">@T["Sort_Price_Asc"]</option>
                <option value="price_desc" selected="@(Model.Sort=="price_desc")">@T["Sort_Price_Desc"]</option>
            </select>
        </div>
        <div class="col-lg-2">
            <input type="number" step="0.01" min="0" name="minPrice" value="@(Model.MinPrice?.ToString("0.00") ?? "")" class="form-control" placeholder="@T["MinPrice"]" aria-label="Min price" />
        </div>
        <div class="col-lg-2">
            <input type="number" step="0.01" min="0" name="maxPrice" value="@(Model.MaxPrice?.ToString("0.00") ?? "")" class="form-control" placeholder="@T["MaxPrice"]" aria-label="Max price" />
        </div>
        <div class="col-lg-1 d-grid">
            <button type="submit" class="btn btn-primary">@T["Search_Button"]</button>
        </div>
    </form>
    @if (!string.IsNullOrWhiteSpace(q))
    {
        <p class="mt-2">@T["Results_For"] <strong>@q</strong> - @T["Found"] @Model.Total</p>
    }
    <hr />
  </div>

@if (Model.Total == 0)
{
    <div class="alert alert-info">@T["NoItems"]</div>
}

<div class="row mt-3">
    @foreach (var sock in Model.Items)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <a asp-controller="Products" asp-action="Details" asp-route-id="@sock.Id">
                    <img src="@sock.ImageUrl" class="card-img-top product-card-img" alt="@sock.Name">
                </a>
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@Html.Raw(Highlight(sock.Name ?? string.Empty, q))</h5>
                    <p class="card-text">@Html.Raw(Highlight(sock.Description ?? string.Empty, q))</p>
                    <p class="card-text mt-auto"><strong>@T["Price"]: @Currency.Eur(sock.Price)</strong></p>
                    <div class="d-flex gap-2">
                        <a asp-controller="Products" asp-action="Details" asp-route-id="@sock.Id" class="btn btn-outline-secondary">@T["Details"]</a>
                        <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@sock.Id" class="btn btn-primary">@T["AddToCart"]</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Catalog pagination" class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-q="@Model.Query" asp-route-sort="@Model.Sort" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-page="@(Model.Page - 1)">« @T["Prev"]</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(Model.Page == i ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-q="@Model.Query" asp-route-sort="@Model.Sort" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-page="@i">@i</a>
                </li>
            }
            <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-q="@Model.Query" asp-route-sort="@Model.Sort" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-page="@(Model.Page + 1)">@T["Next"] »</a>
            </li>
        </ul>
    </nav>
}

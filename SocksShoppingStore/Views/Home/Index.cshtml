@model SocksShoppingStore.Models.CatalogViewModel
@{
    ViewData["Title"] = T["Catalog_Title"];
    var q = Model.Query ?? string.Empty;
    string Highlight(string text, string query)
    {
        if (string.IsNullOrWhiteSpace(text) || string.IsNullOrWhiteSpace(query)) return System.Net.WebUtility.HtmlEncode(text ?? "");
        var encoded = System.Net.WebUtility.HtmlEncode(text);
        var regex = new System.Text.RegularExpressions.Regex(System.Text.RegularExpressions.Regex.Escape(query), System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return regex.Replace(encoded, m => $"<mark>{m.Value}</mark>");
    }
}

<div class="text-center">
    <h1 class="display-4">@T["Home_Title"]</h1>
    <p class="lead">@T["Home_Lead"]</p>
    <hr />
    <form method="get" asp-controller="Home" asp-action="Index" class="row g-2 mt-3" role="region" aria-label="Catalog filters">
        <input type="hidden" name="q" value="@q" />
        <div class="col-12 col-md-6 d-flex align-items-center gap-2">
            <strong class="text-nowrap">@T["Price"]:</strong>
            <input type="number" step="0.01" min="0" name="minPrice" value="@(Model.MinPrice?.ToString("0.00") ?? "")" class="form-control" placeholder="@T["Min"]" aria-label="@T["MinPriceAria"]" />
            <span>-</span>
            <input type="number" step="0.01" min="0" name="maxPrice" value="@(Model.MaxPrice?.ToString("0.00") ?? "")" class="form-control" placeholder="@T["Max"]" aria-label="@T["MaxPriceAria"]" />
        </div>
        <div class="col-12 col-md-6 d-flex align-items-center gap-2">
            <strong class="text-nowrap">@T["Sort"]:</strong>
            <div class="btn-group" role="group" aria-label="Sort options">
                <a class="btn btn-outline-secondary @(Model.Sort=="price_asc"?"active":"")" asp-action="Index" asp-route-q="@Model.Query" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-sort="price_asc">
                    <i class="fa-solid fa-arrow-up"></i> @T["Price"]
                </a>
                <a class="btn btn-outline-secondary @(Model.Sort=="price_desc"?"active":"")" asp-action="Index" asp-route-q="@Model.Query" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-sort="price_desc">
                    <i class="fa-solid fa-arrow-down"></i> @T["Price"]
                </a>
                <a class="btn btn-outline-secondary @(Model.Sort=="name_asc"?"active":"")" asp-action="Index" asp-route-q="@Model.Query" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-sort="name_asc">
                    <i class="fa-solid fa-arrow-up-a-z"></i> @T["Name"]
                </a>
                <a class="btn btn-outline-secondary @(Model.Sort=="name_desc"?"active":"")" asp-action="Index" asp-route-q="@Model.Query" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-sort="name_desc">
                    <i class="fa-solid fa-arrow-down-z-a"></i> @T["Name"]
                </a>
            </div>
            <div class="ms-auto d-flex gap-2">
                <a class="btn btn-outline-secondary" asp-action="Index" asp-route-q="@Model.Query">@T["Reset"]</a>
                <button type="submit" class="btn btn-primary">@T["Apply"]</button>
            </div>
        </div>
    </form>
    @if (!string.IsNullOrWhiteSpace(q))
    {
        <p class="mt-2">@T["Results_For"] <strong>@q</strong> - @T["Found"] @Model.Total</p>
    }
    <hr />
  </div>

@if (Model.Total == 0)
{
    <div class="alert alert-info">@T["NoItems"]</div>
}

<div class="row mt-3" id="catalog-grid" data-loaded="@Model.Items.Count" data-total="@Model.Total" data-page="@Model.Page" data-pagesize="@Model.PageSize" data-q="@Model.Query" data-sort="@Model.Sort" data-minprice="@Model.MinPrice" data-maxprice="@Model.MaxPrice" data-price-label="@T["Price"]" data-details-label="@T["Details"]" data-addtocart-label="@T["AddToCart"]" data-loadmore-label="@T["LoadMore"]" data-loading-label="@T["Loading"]" data-allloaded-label="@T["AllItemsLoaded"]">
    @foreach (var sock in Model.Items)
    {
        <div class="col-6 col-sm-4 mb-4">
            <div class="card h-100">
                <a asp-controller="Products" asp-action="Details" asp-route-id="@sock.Id">
                    <img src="@sock.ImageUrl" class="card-img-top product-card-img" alt="@sock.Name">
                </a>
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@Html.Raw(Highlight(sock.Name ?? string.Empty, q))</h5>
                    <p class="card-text">@Html.Raw(Highlight(sock.Description ?? string.Empty, q))</p>
                    <p class="card-text mt-auto"><strong>@T["Price"]: @Currency.Eur(sock.Price)</strong></p>
                    <div class="d-flex gap-2">
                        <a asp-controller="Products" asp-action="Details" asp-route-id="@sock.Id" class="btn btn-outline-secondary">@T["Details"]</a>
                        <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@sock.Id" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)" class="btn btn-primary">@T["AddToCart"]</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
<div class="text-center mt-3" id="load-more-wrap">
    @if (Model.Items.Count < Model.Total)
    {
        <button id="load-more" class="btn btn-outline-primary">@T["LoadMore"]</button>
    }
    else
    {
        <span class="text-muted">@T["AllItemsLoaded"]</span>
    }
</div>

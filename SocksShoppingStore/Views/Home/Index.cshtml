@model List<SocksShoppingStore.Models.Sock>
@{
    ViewData["Title"] = "Socks catalog";
    var q = (ViewData["Query"] as string) ?? string.Empty;
    string Highlight(string text, string query)
    {
        if (string.IsNullOrWhiteSpace(text) || string.IsNullOrWhiteSpace(query)) return System.Net.WebUtility.HtmlEncode(text ?? "");
        var encoded = System.Net.WebUtility.HtmlEncode(text);
        var regex = new System.Text.RegularExpressions.Regex(System.Text.RegularExpressions.Regex.Escape(query), System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return regex.Replace(encoded, m => $"<mark>{m.Value}</mark>");
    }
}

<div class="text-center">
    <h1 class="display-4">Welcome to SocksShoppingStore</h1>
    <p class="lead">Pick the perfect socks for you and your team</p>
    <hr />
    <form method="get" asp-controller="Home" asp-action="Index" class="row g-2 mt-3">
        <div class="col-md-10">
            <input type="text" name="q" class="form-control" value="@q" placeholder="Search by name or description" />
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </form>
    @if (!string.IsNullOrWhiteSpace(q))
    {
        <p class="mt-2">Results for: <strong>@q</strong> — found @Model.Count</p>
    }
    <hr />
  </div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No items found. Try a shorter query, check spelling, or clear the search box.</div>
}

<div class="row mt-3">
    @foreach (var sock in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <a asp-controller="Products" asp-action="Details" asp-route-id="@sock.Id">
                    <img src="@sock.ImageUrl" class="card-img-top" alt="@sock.Name" style="height: 300px; object-fit: cover;">
                </a>
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@Html.Raw(Highlight(sock.Name ?? string.Empty, q))</h5>
                    <p class="card-text">@Html.Raw(Highlight(sock.Description ?? string.Empty, q))</p>
                    <p class="card-text mt-auto"><strong>Price: @sock.Price.ToString("C")</strong></p>
                    <div class="d-flex gap-2">
                        <a asp-controller="Products" asp-action="Details" asp-route-id="@sock.Id" class="btn btn-outline-secondary">Details</a>
                        <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@sock.Id" class="btn btn-primary">Add to cart</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

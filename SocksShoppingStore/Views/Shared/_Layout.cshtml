<!-- Файл: Views/Shared/_Layout.cshtml -->
@using SocksShoppingStore.Helpers
@using SocksShoppingStore.Models

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SocksShoppingStore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SocksShoppingStore.styles.css" asp-append-version="true" />
    <!-- Добавляем иконки Font Awesome для корзины -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">SocksShoppingStore</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">@T["Nav_Home"]</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="langDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Language selector">
                                @T["Nav_Language"]
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="langDropdown">
                                <li>
                                    <form class="px-3 py-1" method="post" asp-controller="Localization" asp-action="Set">
                                        <input type="hidden" name="culture" value="en" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button class="dropdown-item" type="submit">English</button>
                                    </form>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form class="px-3 py-1" method="post" asp-controller="Localization" asp-action="Set">
                                        <input type="hidden" name="culture" value="ru" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button class="dropdown-item" type="submit">Русский</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            @{
                                var cart = Context.Session.Get<ShoppingCart>("Cart") ?? new ShoppingCart();
                                var totalItems = cart.GetTotalItems();
                                var totalSum = cart.GetTotalSum();
                            }
                            <a class="nav-link text-dark" asp-controller="Cart" asp-action="Index" aria-label="Cart">
                                <i class="fa-solid fa-cart-shopping"></i>
                                @T["Nav_Cart"] <span class="badge bg-primary rounded-pill" aria-label="Items in cart">@totalItems</span>
                                <span class="ms-1 text-muted" aria-label="Cart total">@Currency.Eur(totalSum)</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container-fluid text-start px-3">
            &copy; 2025 - Moseyko Stanislav - <a asp-area="" asp-controller="Legal" asp-action="Terms">@T["Footer_Terms"]</a> | <a asp-controller="Legal" asp-action="Privacy">@T["Footer_Privacy"]</a>
        </div>
    </footer>
    <!-- Cookie consent banner (essential cookies only) -->
    <div id="cookie-consent" class="alert alert-info cookie-consent" role="alert" aria-live="polite">
        <div class="d-flex justify-content-between align-items-center">
            <span>@T["Cookie_Text"]</span>
            <div class="ms-3">
                <a class="btn btn-sm btn-outline-secondary" asp-controller="Legal" asp-action="Privacy">@T["Cookie_LearnMore"]</a>
                <button id="cookie-accept" class="btn btn-sm btn-primary ms-2">@T["Cookie_Accept"]</button>
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/cookies.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
